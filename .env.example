# Copie este arquivo para .env.local e preencha os valores.
# .env.local nunca é commitado (já está no .gitignore).

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Domínio final (sem barra no fim). Sem isso, cai no domínio da Vercel ou
# em localhost — só afeta URLs absolutas de SEO/Open Graph.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Sanity CMS
# 1. Crie uma conta e um projeto grátis em https://www.sanity.io/manage
# 2. O Project ID aparece no painel do projeto.
# 3. Dataset padrão costuma ser "production" (criado automaticamente).
# Sem essas variáveis, o site usa o conteúdo mock em src/lib/mock-content.ts.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# ---------------------------------------------------------------------------
# Resend (envio do formulário de contato por e-mail)
# 1. Crie uma conta grátis em https://resend.com
# 2. Gere uma API Key em https://resend.com/api-keys
# 3. CONTACT_EMAIL_TO é o e-mail que vai RECEBER as mensagens do site.
# 4. CONTACT_EMAIL_FROM precisa ser de um domínio verificado no Resend —
#    até verificar um domínio próprio, pode deixar em branco (usa o
#    remetente de testes padrão do Resend).
# Sem RESEND_API_KEY, o formulário mostra validação mas o envio real fica
# desativado (retorna erro amigável).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (proteção anti-spam do formulário)
# 1. Crie um site grátis em https://dash.cloudflare.com/?to=/:account/turnstile
# 2. Copie a Site Key (pública) e a Secret Key (privada).
# Sem essas variáveis, o formulário funciona normalmente mas sem proteção
# anti-spam (o widget simplesmente não aparece).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
